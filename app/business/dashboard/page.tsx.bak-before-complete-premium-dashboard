"use client";

import Link from "next/link";
import { useCallback, useEffect, useMemo, useState } from "react";
import { getToken } from "@/lib/auth";

const API_URL =
  process.env.NEXT_PUBLIC_API_URL || "http://localhost:5001";

type Business = {
  _id?: string;
  businessName: string;
  description?: string;
  category?: string;
  phone?: string;
  email?: string;
  address?: string;
  city?: string;
  state?: string;
  pincode?: string;
  logo?: string;
  images?: string[];
  verificationStatus?: string;
  rejectionReason?: string;
  verifiedAt?: string | null;
  status?: string;
  owner?: {
    _id?: string;
    name?: string;
    email?: string;
    phone?: string;
    role?: string;
    status?: string;
  };
};

type Listing = {
  _id: string;
  title: string;
  category?: string;
  location?: string;
  price?: string;
  status?: string;
  image?: string;
};

function pretty(value?: string) {
  return (value || "pending")
    .replace(/_/g, " ")
    .replace(/\b\w/g, (x) => x.toUpperCase());
}

function statusClass(value?: string) {
  const v = (value || "pending").toLowerCase();

  if (v === "published" || v === "verified" || v === "active") {
    return "mv-status mv-status-success";
  }

  if (v === "rejected" || v === "suspended" || v === "blocked") {
    return "mv-status mv-status-danger";
  }

  return "mv-status mv-status-warning";
}

export default function BusinessDashboard() {
  const [business, setBusiness] = useState<Business | null>(null);
  const [listings, setListings] = useState<Listing[]>([]);
  const [verification, setVerification] = useState<any>(null);
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [error, setError] = useState("");
  const [lastUpdated, setLastUpdated] = useState<Date | null>(null);

  const loadDashboard = useCallback(async (manual = false) => {
    try {
      if (manual) {
        setRefreshing(true);
      } else {
        setLoading(true);
      }

      setError("");

      const token = getToken();

      if (!token) {
        window.location.href = "/login";
        return;
      }

      const cacheBust = Date.now();

      const [businessResponse, listingsResponse] = await Promise.all([
        fetch(`${API_URL}/api/business/me?_t=${cacheBust}`, {
          cache: "no-store",
          headers: {
            Authorization: `Bearer ${token}`,
            "Cache-Control": "no-cache",
            Pragma: "no-cache",
          },
        }),

        fetch(
          `${API_URL}/api/listings/business/mine?_t=${cacheBust}`,
          {
            cache: "no-store",
            headers: {
              Authorization: `Bearer ${token}`,
              "Cache-Control": "no-cache",
              Pragma: "no-cache",
            },
          }
        ),
      ]);

      if (!businessResponse.ok) {
        throw new Error("Unable to load business profile");
      }

      if (!listingsResponse.ok) {
        throw new Error("Unable to load listings");
      }

      const businessData = await businessResponse.json();
      const listingsData = await listingsResponse.json();

      setBusiness(businessData.business || null);
      setVerification(businessData.verification || null);
      setListings(
        Array.isArray(listingsData)
          ? listingsData
          : Array.isArray(listingsData?.listings)
            ? listingsData.listings
            : []
      );
      setLastUpdated(new Date());
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Failed to load business dashboard"
      );
    } finally {
      setLoading(false);
      setRefreshing(false);
    }
  }, []);

  useEffect(() => {
    loadDashboard();
  }, [loadDashboard]);

  const stats = useMemo(() => {
    const published = listings.filter(
      (x) => x.status?.toLowerCase() === "published"
    ).length;

    const pending = listings.filter(
      (x) => x.status?.toLowerCase() === "pending"
    ).length;

    const other = Math.max(
      listings.length - published - pending,
      0
    );

    return {
      total: listings.length,
      published,
      pending,
      other,
    };
  }, [listings]);

  const verificationStatus =
    business?.verificationStatus ||
    verification?.status ||
    "pending";

  if (loading) {
    return (
      <main className="mv-business-dashboard mv-dashboard-loading">
        <div className="mv-loading-card">
          <div className="mv-dashboard-brand">
            metro<span>vybe</span><sup>✦</sup>
          </div>

          <div className="mv-dashboard-spinner" />

          <strong>Loading your dashboard</strong>
          <p>Getting your latest business information...</p>
        </div>

        <style jsx>{styles}</style>
      </main>
    );
  }

  if (error) {
    return (
      <main className="mv-business-dashboard mv-dashboard-error">
        <div className="mv-error-card">
          <div className="mv-error-icon">!</div>
          <h1>Something went wrong</h1>
          <p>{error}</p>

          <button
            type="button"
            className="mv-primary-btn"
            onClick={() => loadDashboard(true)}
          >
            Try again
          </button>

        </div>

        <style jsx>{styles}</style>
      </main>
    );
  }

  return (
    <main className="mv-business-dashboard">
      <div className="mv-dashboard-shell">

        {/* TOP BAR */}
        <header className="mv-dashboard-topbar">
          <Link href="/" className="mv-dashboard-logo">
            metro<span>vybe</span><sup>✦</sup>
          </Link>

          <div className="mv-topbar-actions">
            <button
              type="button"
              className="mv-refresh-btn"
              onClick={() => loadDashboard(true)}
              disabled={refreshing}
              aria-label="Refresh dashboard"
            >
              <span className={refreshing ? "mv-refresh-spin" : ""}>
                ↻
              </span>
              <span className="mv-refresh-text">
                {refreshing ? "Refreshing..." : "Refresh"}
              </span>
            </button>

            <button
              type="button"
              className="mv-logout-btn"
              onClick={() => {
                try {
                  localStorage.removeItem("token");
                  localStorage.removeItem("metrovybe_token");
                  localStorage.removeItem("authToken");
                  sessionStorage.removeItem("token");
                } catch {}

                window.location.href = "/login";
              }}
              aria-label="Log out"
            >
              <span className="mv-logout-icon">↪</span>
              <span>Log out</span>
            </button>

          </div>
        </header>

        {/* PAGE INTRO */}
        <section className="mv-dashboard-intro">
          <div>
            <div className="mv-eyebrow">BUSINESS CENTER</div>

            <h1>
              Welcome back
              {business?.owner?.name
                ? `, ${business.owner.name.split(" ")[0]}`
                : ""}
              .
            </h1>

            <p>
              Manage your business presence, listings and verification
              from one place.
            </p>
          </div>

          {lastUpdated && (
            <div className="mv-last-updated">
              <span className="mv-live-dot" />
              Updated {lastUpdated.toLocaleTimeString([], {
                hour: "2-digit",
                minute: "2-digit",
              })}
            </div>
          )}
        </section>

        {/* BUSINESS HERO */}
        {business && (
          <section className="mv-business-hero">

            <div className="mv-business-identity">

              <div className="mv-business-avatar">
                {business.logo ? (
                  <img
                    src={business.logo}
                    alt={business.businessName}
                  />
                ) : (
                  <span>
                    {(business.businessName || "B")
                      .charAt(0)
                      .toUpperCase()}
                  </span>
                )}
              </div>

              <div className="mv-business-main">
                <div className="mv-business-title-row">
                  <h2>
                    {business.businessName || "Your Business"}
                  </h2>

                  <span className={statusClass(verificationStatus)}>
                    {verificationStatus === "verified" && "✓ "}
                    {pretty(verificationStatus)}
                  </span>
                </div>

                <p className="mv-business-meta">
                  {business.category || "Business"}
                  {business.city ? ` · ${business.city}` : ""}
                  {business.state ? `, ${business.state}` : ""}
                </p>

                {business.description && (
                  <p className="mv-business-description">
                    {business.description}
                  </p>
                )}

                <div className="mv-business-contact-row">
                  {business.email && (
                    <span>✉ {business.email}</span>
                  )}

                  {business.phone && (
                    <span>☎ {business.phone}</span>
                  )}
                </div>
              </div>
            </div>

            <div className="mv-business-hero-side">
              <div className="mv-account-label">
                ACCOUNT STATUS
              </div>

              <strong>
                {pretty(business.status || "active")}
              </strong>

              <span>
                {business.verifiedAt
                  ? "Verified business account"
                  : "Business profile active"}
              </span>
            </div>
          </section>
        )}

        {/* VERIFICATION ALERT */}
        {business &&
          verificationStatus !== "verified" && (
            <section
              className={`mv-verification-alert ${
                verificationStatus === "rejected" ||
                verificationStatus === "suspended"
                  ? "mv-alert-danger"
                  : ""
              }`}
            >
              <div className="mv-alert-icon">
                {verificationStatus === "rejected" ||
                verificationStatus === "suspended"
                  ? "!"
                  : "✓"}
              </div>

              <div>
                <strong>
                  {verificationStatus === "rejected"
                    ? "Verification needs attention"
                    : verificationStatus === "suspended"
                      ? "Business account suspended"
                      : "Business verification is pending"}
                </strong>

                <p>
                  {business.rejectionReason ||
                    (verificationStatus === "pending"
                      ? "Your business information is currently under review."
                      : "Please review your business information and required documents.")}
                </p>
              </div>
            </section>
          )}

        {/* STATS */}
        <section className="mv-dashboard-stats">

          <div className="mv-stat-card mv-stat-primary">
            <div className="mv-stat-icon">▦</div>
            <div>
              <span>Total Listings</span>
              <strong>{stats.total}</strong>
            </div>
          </div>

          <div className="mv-stat-card">
            <div className="mv-stat-icon mv-icon-green">✓</div>
            <div>
              <span>Published</span>
              <strong>{stats.published}</strong>
            </div>
          </div>

          <div className="mv-stat-card">
            <div className="mv-stat-icon mv-icon-yellow">◷</div>
            <div>
              <span>Pending Review</span>
              <strong>{stats.pending}</strong>
            </div>
          </div>

          <div className="mv-stat-card">
            <div className="mv-stat-icon mv-icon-purple">+</div>
            <div>
              <span>Other</span>
              <strong>{stats.other}</strong>
            </div>
          </div>

        </section>

        {/* QUICK ACTIONS */}
        <section className="mv-quick-actions">
          <div className="mv-section-heading">
            <div>
              <div className="mv-eyebrow">MANAGE</div>
              <h2>Quick actions</h2>
            </div>
          </div>

          <div className="mv-action-grid">

            <Link
              href="/business/listings/new"
              className="mv-action-card mv-action-main"
            >
              <div className="mv-action-icon">+</div>
              <div>
                <strong>Add a new listing</strong>
                <span>Create and publish a new business listing.</span>
              </div>
              <b>→</b>
            </Link>

            <button
              type="button"
              className="mv-action-card"
              onClick={() => loadDashboard(true)}
            >
              <div className="mv-action-icon mv-action-refresh">
                ↻
              </div>
              <div>
                <strong>Refresh business data</strong>
                <span>Fetch the latest profile and listing information.</span>
              </div>
              <b>→</b>
            </button>

            <Link
              href="/"
              className="mv-action-card"
            >
              <div className="mv-action-icon mv-action-view">
                ↗
              </div>
              <div>
                <strong>View marketplace</strong>
                <span>See how MetroVybe customers discover businesses.</span>
              </div>
              <b>→</b>
            </Link>

          </div>
        </section>

        {/* LISTINGS */}
        <section className="mv-listings-section">

          <div className="mv-section-heading mv-listings-heading">
            <div>
              <div className="mv-eyebrow">YOUR BUSINESS</div>
              <h2>Your listings</h2>
              <p>
                Keep your MetroVybe listings accurate and up to date.
              </p>
            </div>

            <Link
              href="/business/listings/new"
              className="mv-add-listing-btn"
            >
              <span>+</span>
              Add Listing
            </Link>
          </div>

          {listings.length === 0 ? (
            <div className="mv-empty-listings">
              <div className="mv-empty-icon">▦</div>

              <h3>No listings yet</h3>

              <p>
                Your business profile is ready. Create your first
                listing to start appearing on MetroVybe.
              </p>

              <Link
                href="/business/listings/new"
                className="mv-primary-btn"
              >
                Create your first listing
                <span>→</span>
              </Link>
            </div>
          ) : (
            <div className="mv-listings-grid">
              {listings.map((listing) => (
                <article
                  key={listing._id}
                  className="mv-listing-card"
                >
                  <div className="mv-listing-image">
                    {listing.image ? (
                      <img
                        src={listing.image}
                        alt={listing.title}
                      />
                    ) : (
                      <div className="mv-listing-image-placeholder">
                        <span>MV</span>
                      </div>
                    )}

                    <span className={statusClass(listing.status)}>
                      {pretty(listing.status)}
                    </span>
                  </div>

                  <div className="mv-listing-content">
                    <div className="mv-listing-category">
                      {listing.category || "Business listing"}
                    </div>

                    <h3>{listing.title}</h3>

                    {listing.location && (
                      <p className="mv-listing-location">
                        <span>⌖</span>
                        {listing.location}
                      </p>
                    )}

                    <div className="mv-listing-footer">
                      <strong>
                        {listing.price || "Contact for price"}
                      </strong>

                      <span>
                        Listing ID: {listing._id.slice(-6)}
                      </span>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          )}
        </section>

        {/* BUSINESS INFORMATION */}
        {business && (
          <section className="mv-information-section">

            <div className="mv-section-heading">
              <div>
                <div className="mv-eyebrow">PROFILE</div>
                <h2>Business information</h2>
              </div>
            </div>

            <div className="mv-information-grid">

              <div className="mv-info-card">
                <span>Business email</span>
                <strong>
                  {business.email ||
                    business.owner?.email ||
                    "Not provided"}
                </strong>
              </div>

              <div className="mv-info-card">
                <span>Phone</span>
                <strong>
                  {business.phone ||
                    business.owner?.phone ||
                    "Not provided"}
                </strong>
              </div>

              <div className="mv-info-card">
                <span>Category</span>
                <strong>
                  {business.category || "Not specified"}
                </strong>
              </div>

              <div className="mv-info-card">
                <span>Owner</span>
                <strong>
                  {business.owner?.name || "Business owner"}
                </strong>
              </div>

              <div className="mv-info-card mv-info-wide">
                <span>Address</span>
                <strong>
                  {business.address || "Address not provided"}
                </strong>
              </div>

              <div className="mv-info-card mv-info-wide">
                <span>Location</span>
                <strong>
                  {[business.city, business.state, business.pincode]
                    .filter(Boolean)
                    .join(", ") || "Location not provided"}
                </strong>
              </div>

            </div>
          </section>
        )}

        {/* FOOTER */}
        <footer className="mv-dashboard-footer">
          <span>
            metro<span>vybe</span> · Business Center
          </span>

        </footer>

      </div>

      <style jsx>{styles}</style>
    </main>
  );
}

