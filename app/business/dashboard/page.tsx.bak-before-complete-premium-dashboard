  .mv-verification-alert p {
    margin: 4px 0 0;
    color: #756a4a;
    font-size: 12px;
    line-height: 1.5;
  }

  .mv-dashboard-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin: 20px 0 34px;
  }

  .mv-stat-card {
    background: #fff;
    border: 1px solid #e8ebec;
    border-radius: 17px;
    padding: 19px;
    display: flex;
    gap: 13px;
    align-items: center;
    box-shadow: 0 5px 18px rgba(0,0,0,.035);
  }

  .mv-stat-primary {
    border-color: rgba(41,171,135,.35);
  }

  .mv-stat-icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: #eaf8f4;
    color: #29AB87;
    display: grid;
    place-items: center;
    font-size: 20px;
    font-weight: 900;
  }

  .mv-icon-green {
    background: #e3f7ee;
    color: #16815f;
  }

  .mv-icon-yellow {
    background: #fff4d6;
    color: #a87400;
  }

  .mv-icon-purple {
    background: #eee8ff;
    color: #7152c7;
  }

  .mv-stat-card span {
    display: block;
    color: #7b8588;
    font-size: 11px;
    font-weight: 800;
  }

  .mv-stat-card strong {
    display: block;
    margin-top: 3px;
    font-size: 25px;
    letter-spacing: -.7px;
  }

  .mv-section-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 15px;
  }

  .mv-section-heading h2 {
    margin: 0;
    font-size: 22px;
    letter-spacing: -.6px;
  }

  .mv-section-heading p {
    margin: 5px 0 0;
    color: #7a8386;
    font-size: 13px;
  }

  .mv-action-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 13px;
  }

  .mv-action-card {
    border: 1px solid #e5e9ea;
    background: #fff;
    border-radius: 16px;
    padding: 17px;
    display: flex;
    align-items: center;
    gap: 12px;
    text-align: left;
    color: #111;
    text-decoration: none;
    cursor: pointer;
    transition: .2s ease;
  }

  .mv-action-card:hover {
    transform: translateY(-2px);
    border-color: #29AB87;
    box-shadow: 0 9px 25px rgba(0,0,0,.06);
  }

  .mv-action-main {
    background: #29AB87;
    color: #fff;
    border-color: #29AB87;
  }

  .mv-action-icon {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: #e9f8f3;
    color: #29AB87;
    font-size: 21px;
    font-weight: 900;
    flex-shrink: 0;
  }

  .mv-action-main .mv-action-icon {
    background: rgba(255,255,255,.18);
    color: #fff;
  }

  .mv-action-refresh {
    color: #6654bd;
    background: #eeeaff;
  }

  .mv-action-view {
    color: #a56a00;
    background: #fff1d5;
  }

  .mv-action-card div:nth-child(2) {
    flex: 1;
  }

  .mv-action-card strong {
    display: block;
    font-size: 13px;
  }

  .mv-action-card span {
    display: block;
    margin-top: 3px;
    color: #7c8588;
    font-size: 11px;
    line-height: 1.35;
  }

  .mv-action-main span {
    color: rgba(255,255,255,.78);
  }

  .mv-action-card > b {
    font-size: 18px;
  }

  .mv-listings-section {
    margin-top: 40px;
  }

  .mv-listings-heading {
    margin-bottom: 18px;
  }

  .mv-add-listing-btn {
    background: #111;
    color: #fff;
    padding: 11px 15px;
    border-radius: 11px;
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .mv-add-listing-btn span {
    font-size: 19px;
    line-height: 1;
  }

  .mv-add-listing-btn:hover {
    background: #29AB87;
  }

  .mv-listings-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
  }

  .mv-listing-card {
    background: #fff;
    border: 1px solid #e6e9ea;
    border-radius: 17px;
    overflow: hidden;
    transition: .2s ease;
  }

  .mv-listing-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(0,0,0,.07);
  }

  .mv-listing-image {
    height: 165px;
    background: #edf2f1;
    position: relative;
    overflow: hidden;
  }

  .mv-listing-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mv-listing-image .mv-status {
    position: absolute;
    top: 10px;
    right: 10px;
    box-shadow: 0 2px 8px rgba(0,0,0,.08);
  }

  .mv-listing-image-placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 30% 20%, rgba(41,171,135,.22), transparent 35%),
      #e9f1ef;
  }

  .mv-listing-image-placeholder span {
    font-weight: 950;
    font-size: 28px;
    color: #29AB87;
  }

  .mv-listing-content {
    padding: 15px;
  }

  .mv-listing-category {
    color: #29AB87;
    text-transform: uppercase;
    font-size: 9px;
    font-weight: 950;
    letter-spacing: 1px;
  }

  .mv-listing-content h3 {
    margin: 5px 0 7px;
    font-size: 17px;
    letter-spacing: -.4px;
  }

  .mv-listing-location {
    margin: 0;
    color: #737d80;
    font-size: 11px;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mv-listing-location span {
    margin-right: 4px;
    color: #29AB87;
  }

  .mv-listing-footer {
    border-top: 1px solid #edf0f1;
    margin-top: 13px;
    padding-top: 11px;
    display: flex;
    justify-content: space-between;
    gap: 10px;
    align-items: center;
  }

  .mv-listing-footer strong {
    font-size: 13px;
  }

  .mv-listing-footer span {
    color: #9aa1a3;
    font-size: 9px;
    font-weight: 700;
  }

  .mv-empty-listings {
    background: #fff;
    border: 1px dashed #d8dfe0;
    border-radius: 18px;
    padding: 55px 25px;
    text-align: center;
  }

  .mv-empty-icon {
    width: 55px;
    height: 55px;
    border-radius: 16px;
    margin: 0 auto 14px;
    background: #eaf8f4;
    color: #29AB87;
    display: grid;
    place-items: center;
    font-size: 24px;
    font-weight: 900;
  }

  .mv-empty-listings h3 {
    margin: 0;
    font-size: 19px;
  }

  .mv-empty-listings p {
    max-width: 480px;
    margin: 8px auto 20px;
    color: #7c8588;
    font-size: 13px;
    line-height: 1.5;
  }

  .mv-primary-btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    background: #29AB87;
    color: #fff;
    padding: 12px 17px;
    border-radius: 11px;
  }

  .mv-primary-btn:hover {
    background: #208c70;
    transform: translateY(-1px);
  }

  .mv-secondary-btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    color: #555;
    padding: 10px 15px;
    margin-top: 10px;
  }

  .mv-information-section {
    margin-top: 42px;
  }

  .mv-information-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  .mv-info-card {
    background: #fff;
    border: 1px solid #e7eaeb;
    border-radius: 14px;
    padding: 15px;
    min-width: 0;
  }

  .mv-info-wide {
    grid-column: span 2;
  }

  .mv-info-card span {
    display: block;
    color: #8a9395;
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: .8px;
    font-weight: 900;
    margin-bottom: 5px;
  }

  .mv-info-card strong {
    display: block;
    font-size: 12px;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .mv-dashboard-footer {
    border-top: 1px solid #e1e5e6;
    margin-top: 45px;
    padding-top: 18px;
    display: flex;
    justify-content: space-between;
    gap: 15px;
    color: #8a9294;
    font-size: 11px;
    font-weight: 700;
  }

  .mv-dashboard-footer span:first-child {
    color: #222;
    font-weight: 900;
  }

  .mv-dashboard-footer a {
    color: #555;
    text-decoration: none;
  }

  .mv-dashboard-loading,
  .mv-dashboard-error {
    display: grid;
    place-items: center;
    padding: 20px;
  }

  .mv-loading-card,
  .mv-error-card {
    width: min(420px, 100%);
    background: #fff;
    border: 1px solid #e7eaeb;
    border-radius: 22px;
    padding: 40px 25px;
    text-align: center;
    box-shadow: 0 15px 50px rgba(0,0,0,.07);
  }

  .mv-dashboard-brand {
    font-size: 29px;
    font-weight: 950;
    letter-spacing: -1.5px;
    margin-bottom: 25px;
  }

  .mv-dashboard-brand span {
    color: #29AB87;
  }

  .mv-dashboard-brand sup {
    color: #D4A72C;
    font-size: 14px;
  }

  .mv-dashboard-spinner {
    width: 32px;
    height: 32px;
    border: 3px solid #e4e8e9;
    border-top-color: #29AB87;
    border-radius: 50%;
    animation: mvSpin .8s linear infinite;
    margin: 0 auto 15px;
  }

  .mv-loading-card strong {
    display: block;
    font-size: 15px;
  }

  .mv-loading-card p,
  .mv-error-card p {
    color: #7a8386;
    font-size: 13px;
    margin: 7px 0 20px;
  }

  .mv-error-icon {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    background: #ffe4e4;
    color: #c52d2d;
    display: grid;
    place-items: center;
    margin: 0 auto 15px;
    font-size: 22px;
    font-weight: 950;
  }

  .mv-error-card h1 {
    margin: 0;
    font-size: 23px;
  }

  @media (max-width: 900px) {
    .mv-dashboard-stats {
      grid-template-columns: repeat(2, 1fr);
    }

    .mv-action-grid,
    .mv-listings-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .mv-information-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .mv-info-wide {
      grid-column: span 2;
    }

    .mv-business-hero {
      flex-direction: column;
    }

    .mv-business-hero-side {
      width: fit-content;
    }
  }

  @media (max-width: 640px) {
    .mv-dashboard-shell {
      width: min(100% - 24px, 1240px);
      padding-top: 12px;
      padding-bottom: 35px;
    }

    .mv-dashboard-topbar {
      margin-bottom: 30px;
      height: 48px;
    }

    .mv-dashboard-logo {
      font-size: 23px;
    }

    .mv-refresh-text,
    .mv-marketplace-btn {
      display: none;
    }

    .mv-refresh-btn {
      width: 40px;
      height: 40px;
      padding: 0;
      justify-content: center;
    }

    .mv-dashboard-intro {
      display: block;
    }

    .mv-dashboard-intro h1 {
      font-size: 34px;
      letter-spacing: -1.5px;
    }

    .mv-dashboard-intro p {
      font-size: 13px;
      line-height: 1.45;
    }

    .mv-last-updated {
      display: inline-block;
      margin-top: 13px;
    }

    .mv-business-hero {
      padding: 19px;
      border-radius: 18px;
    }

    .mv-business-identity {
      align-items: flex-start;
    }

    .mv-business-avatar {
      width: 57px;
      height: 57px;
      border-radius: 14px;
      font-size: 22px;
    }

    .mv-business-title-row h2 {
      font-size: 20px;
    }

    .mv-business-contact-row {
      flex-direction: column;
      gap: 5px;
    }

    .mv-business-hero-side {
      width: 100%;
      box-sizing: border-box;
    }

    .mv-dashboard-stats {
      grid-template-columns: repeat(2, 1fr);
      gap: 9px;
      margin-bottom: 28px;
    }

    .mv-stat-card {
      padding: 14px;
      border-radius: 14px;
    }

    .mv-stat-icon {
      width: 35px;
      height: 35px;
      border-radius: 10px;
      font-size: 17px;
    }

    .mv-stat-card strong {
      font-size: 22px;
    }

    .mv-stat-card span {
      font-size: 9px;
    }

    .mv-action-grid,
    .mv-listings-grid {
      grid-template-columns: 1fr;
    }

    .mv-action-card {
      padding: 14px;
    }

    .mv-section-heading {
      align-items: flex-start;
    }

    .mv-section-heading h2 {
      font-size: 20px;
    }

    .mv-add-listing-btn {
      padding: 9px 12px;
      font-size: 12px;
      white-space: nowrap;
    }

    .mv-listing-image {
      height: 185px;
    }

    .mv-information-grid {
      grid-template-columns: 1fr;
    }

    .mv-info-wide {
      grid-column: span 1;
    }

    .mv-dashboard-footer {
      flex-direction: column;
    }

    .mv-verification-alert {
      padding: 13px;
    }
  }

  .mv-logout-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 42px;
    padding: 0 15px;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    background: #fff;
    color: #111;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
    transition:
      transform .18s ease,
      box-shadow .18s ease,
      border-color .18s ease,
      background .18s ease;
  }

  .mv-logout-btn:hover {
    transform: translateY(-1px);
    border-color: #d1d5db;
    background: #fafafa;
    box-shadow: 0 8px 20px rgba(0,0,0,.07);
  }

  .mv-logout-btn:active {
    transform: translateY(0);
  }

  .mv-logout-icon {
    width: 22px;
    height: 22px;
    display: inline-grid;
    place-items: center;
    border-radius: 7px;
    background: #f1f3f5;
    font-size: 16px;
    font-weight: 900;
    line-height: 1;
  }

  .mv-business-avatar {
    width: 96px !important;
    height: 96px !important;
    min-width: 96px !important;
    border-radius: 24px !important;
    overflow: hidden;
    box-shadow:
      0 0 0 4px #fff,
      0 8px 24px rgba(0,0,0,.10);
  }

  .mv-business-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mv-business-avatar > span {
    font-size: 34px !important;
    font-weight: 900;
  }

  @media (max-width: 640px) {
    .mv-business-avatar {
      width: 78px !important;
      height: 78px !important;
      min-width: 78px !important;
      border-radius: 20px !important;
    }

    .mv-business-avatar > span {
      font-size: 28px !important;
    }

    .mv-logout-btn {
      min-height: 40px;
      padding: 0 12px;
      border-radius: 11px;
    }

    .mv-logout-btn span:last-child {
      display: none;
    }

    .mv-logout-icon {
      width: 24px;
      height: 24px;
      font-size: 17px;
    }
  }

`;
