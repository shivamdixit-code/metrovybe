"use client";

import { useEffect, useState } from "react";
import Link from "next/link";
import {
  ArrowLeft,
  Bell,
  CalendarDays,
  ChevronRight,
  Heart,
  HelpCircle,
  LogOut,
  MapPin,
  ShieldCheck,
  UserRound,
} from "lucide-react";
import { useRouter } from "next/navigation";
import { Header } from "@/components/Header";
import { BottomNav } from "@/components/BottomNav";
import { getToken, getUser, logout, type AuthUser } from "@/lib/auth";

export default function ProfileSettings() {
  const router = useRouter();
  const [user, setUser] = useState<AuthUser | null>(null);
  const [checkingAuth, setCheckingAuth] = useState(true);

  useEffect(() => {
    const token = getToken();
    const currentUser = getUser();

    if (!token || !currentUser) {
      router.replace("/login");
      return;
    }

    if (currentUser.role !== "customer") {
      router.replace(
        currentUser.role === "business" ? "/business/profile" : "/login"
      );
      return;
    }

    setUser(currentUser);
    setCheckingAuth(false);
  }, [router]);

  const handleLogout = () => {
    logout();
    window.dispatchEvent(new Event("metrovybe-auth-changed"));
    router.replace("/login");
  };

  if (checkingAuth || !user) {
    return (
      <div className="page">
        <Header />
        <main className="shell inner profile-page">
          <section className="profile-top">
            <div className="profile-person-info">
              <strong>Loading settings...</strong>
              <span>Please wait a moment.</span>
            </div>
          </section>
        </main>
        <BottomNav active="profile" />
      </div>
    );
  }

  const displayName = user.name?.trim() || "Customer";

  const initials =
    displayName
      .split(/\s+/)
      .filter(Boolean)
      .slice(0, 2)
      .map((part) => part[0]?.toUpperCase())
      .join("") || "C";

  return (
    <div className="page">
      <Header />

      <main className="shell inner profile-page">
        <section
          style={{
            maxWidth: 760,
            margin: "0 auto",
          }}
        >
          <Link
            href="/profile"
            style={{
              display: "inline-flex",
              alignItems: "center",
              gap: 8,
              color: "#111",
              textDecoration: "none",
              fontWeight: 800,
              marginBottom: 26,
            }}
          >
            <ArrowLeft size={18} />
            Back to profile
          </Link>

          <div
            style={{
              background: "#111",
              color: "#fff",
              borderRadius: 28,
              padding: "30px",
              marginBottom: 22,
              boxShadow: "6px 6px 0 rgba(17,17,17,0.12)",
            }}
          >
            <span
              className="profile-kicker"
              style={{ color: "#00e676" }}
            >
              SETTINGS
            </span>

            <div
              style={{
                display: "flex",
                alignItems: "center",
                gap: 18,
                marginTop: 18,
              }}
            >
              <div
                style={{
                  width: 62,
                  height: 62,
                  flexShrink: 0,
                  borderRadius: 20,
                  background: "#00e676",
                  color: "#111",
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "center",
                  fontSize: 22,
                  fontWeight: 900,
                }}
              >
                {initials}
              </div>

              <div>
                <h1
                  style={{
                    margin: 0,
                    color: "#fff",
                    fontSize: "clamp(28px, 5vw, 42px)",
                    letterSpacing: "-0.05em",
                  }}
                >
                  Your account.
                </h1>

                <p
                  style={{
                    margin: "7px 0 0",
                    color: "rgba(255,255,255,0.65)",
                  }}
                >
                  {user.email}
                </p>
              </div>
            </div>
          </div>

          <div
            className="account-menu"
            style={{
              borderRadius: 24,
              overflow: "hidden",
            }}
          >
            <div className="account-menu-item">
              <span className="account-menu-icon">
                <UserRound size={19} />
              </span>

              <span className="account-menu-copy">
                <strong>Personal information</strong>
                <small>
                  {displayName}
                  {user.phone ? ` · ${user.phone}` : ""}
                </small>
              </span>

              <ChevronRight size={18} />
            </div>

            <div className="account-menu-item">
              <span className="account-menu-icon">
                <ShieldCheck size={19} />
              </span>

              <span className="account-menu-copy">
                <strong>Security</strong>
                <small>Password & account protection</small>
              </span>

              <ChevronRight size={18} />
            </div>

            <div className="account-menu-item">
              <span className="account-menu-icon">
                <Bell size={19} />
              </span>

              <span className="account-menu-copy">
                <strong>Notifications</strong>
                <small>Control your MetroVybe alerts</small>
              </span>

              <ChevronRight size={18} />
            </div>

            <Link href="/saved" className="account-menu-item">
              <span className="account-menu-icon">
                <Heart size={19} />
              </span>

              <span className="account-menu-copy">
                <strong>Favourite places</strong>
                <small>Your saved listings</small>
              </span>

              <ChevronRight size={18} />
            </Link>

            <Link href="/bookings" className="account-menu-item">
              <span className="account-menu-icon">
                <CalendarDays size={19} />
              </span>

              <span className="account-menu-copy">
                <strong>Booking history</strong>
                <small>Past and upcoming bookings</small>
              </span>

              <ChevronRight size={18} />
            </Link>

            <Link href="/explore" className="account-menu-item">
              <span className="account-menu-icon">
                <MapPin size={19} />
              </span>

              <span className="account-menu-copy">
                <strong>Explore nearby</strong>
                <small>Discover services around you</small>
              </span>

              <ChevronRight size={18} />
            </Link>

            <div className="account-menu-item">
              <span className="account-menu-icon">
                <HelpCircle size={19} />
              </span>

              <span className="account-menu-copy">
                <strong>Help & support</strong>
                <small>We're here when you need us</small>
              </span>

              <ChevronRight size={18} />
            </div>

            <button
              type="button"
              onClick={handleLogout}
              style={{
                width: "100%",
                border: 0,
                borderTop: "1px solid rgba(17,17,17,0.08)",
                background: "transparent",
                padding: "18px 20px",
                display: "flex",
                alignItems: "center",
                gap: 14,
                cursor: "pointer",
                textAlign: "left",
              }}
            >
              <span className="account-menu-icon">
                <LogOut size={19} />
              </span>

              <span className="account-menu-copy">
                <strong>Log out</strong>
                <small>Sign out of your MetroVybe account</small>
              </span>

              <ChevronRight size={18} />
            </button>
          </div>
        </section>
      </main>

      <BottomNav active="profile" />
    </div>
  );
}
