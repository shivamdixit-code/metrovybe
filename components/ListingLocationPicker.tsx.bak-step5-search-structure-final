            {(Object.keys(MAP_MODES) as Array<
              keyof typeof MAP_MODES
            >).map((mode) => (
              <option key={mode} value={mode}>
                {MAP_MODES[mode].label}
              </option>
            ))}
          </select>
        </div>

        <button
          type="button"
          className="mv-step5-my-location"
          onClick={useMyLocation}
          disabled={locating}
          aria-label="Use my current location"
        >
          {locating ? "…" : "◎"}
        </button>

        <div className="mv-step5-map-tip">
          Drag the pin or tap anywhere on the map
        </div>
      </div>

